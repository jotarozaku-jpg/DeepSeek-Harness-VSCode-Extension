+/**
+ * Read the client's per-session model override from `_meta.model`.
+ * The id shape is validated here; existence on the provider route is
+ * enforced by agent creation and image admission.
+ */
+function sessionModelOverride(params: NewSessionRequest): string | undefined {
+  const meta = (params as { _meta?: unknown })._meta
+  if (typeof meta !== 'object' || meta === null) return undefined
+  const model = (meta as { model?: unknown }).model
+  if (model === undefined) return undefined
+  if (typeof model !== 'string' || !/^[A-Za-z0-9._-]{1,64}$/.test(model)) {
+    throw invalidParams('_meta.model must be a short provider model id')
+  }
+  return model
+}
