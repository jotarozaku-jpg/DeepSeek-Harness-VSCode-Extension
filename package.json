{
  "name": "deepseek-harness-vscode",
  "displayName": "DeepSeek Harness for VS Code",
  "description": "An unofficial VS Code client for DeepSeek Harness over ACP.",
  "version": "0.8.0",
  "publisher": "community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jotarozaku-jpg/DeepSeek-Harness-VSCode-Extension.git"
  },
  "bugs": {
    "url": "https://github.com/jotarozaku-jpg/DeepSeek-Harness-VSCode-Extension/issues"
  },
  "homepage": "https://github.com/jotarozaku-jpg/DeepSeek-Harness-VSCode-Extension#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "categories": ["Machine Learning", "Other"],
  "keywords": ["deepseek", "harness", "acp", "coding agent"],
  "activationEvents": [
    "onCommand:deepseekHarness.openChat",
    "onCommand:deepseekHarness.newConversation",
    "onCommand:deepseekHarness.sendSelection",
    "onCommand:deepseekHarness.openInstallGuide",
    "onWebviewPanel:deepseekHarness.chat"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deepseekHarness.openChat",
        "title": "DeepSeek Harness: Open Chat",
        "icon": { "light": "media/icon.svg", "dark": "media/icon.svg" }
      },
      {
        "command": "deepseekHarness.newConversation",
        "title": "DeepSeek Harness: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "deepseekHarness.cancelTurn",
        "title": "DeepSeek Harness: Cancel Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "deepseekHarness.sendSelection",
        "title": "DeepSeek Harness: Send Selection",
        "icon": "$(send)"
      },
      {
        "command": "deepseekHarness.openInstallGuide",
        "title": "DeepSeek Harness: Open Installation Guide",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "deepseekHarness.openChat", "group": "navigation" }
      ],
      "editor/context": [
        {
          "command": "deepseekHarness.sendSelection",
          "when": "editorHasSelection",
          "group": "deepseekHarness@10"
        }
      ]
    },
    "keybindings": [
      {
        "command": "deepseekHarness.openChat",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "deepseekHarness.cancelTurn",
        "key": "escape",
        "when": "deepseekHarness.turnInProgress"
      },
      {
        "command": "deepseekHarness.sendSelection",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "deepseekHarness.configRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Machine-local configuration directory. Empty uses ~/.deepseek-harness-vscode."
        },
        "deepseekHarness.harnessRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to an external DeepSeek Harness checkout prepared by adapter/setup.ps1. Empty uses ~/.deepseek-harness."
        },
        "deepseekHarness.workingDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Agent working directory. Empty uses the first open VS Code workspace folder."
        },
        "deepseekHarness.nodePath": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "Node.js executable used to launch the ACP adapter."
        },
        "deepseekHarness.modelLabel": {
          "type": "string",
          "default": "DeepSeek V4 Pro",
          "description": "Model label displayed in the chat header."
        },
        "deepseekHarness.defaultModel": {
          "type": "string",
          "enum": ["deepseek-v4-pro", "deepseek-v4-flash", "deepseek-v4-flash-vision-exp"],
          "enumDescriptions": [
            "DeepSeek V4 Pro (text only).",
            "DeepSeek V4 Flash (text only).",
            "DeepSeek V4 Flash Vision Exp (accepts image input)."
          ],
          "default": "deepseek-v4-pro",
          "description": "Model used for newly created conversations. Each conversation can override this from the composer."
        },
        "deepseekHarness.approvalMode": {
          "type": "string",
          "enum": ["manual", "sandbox", "full-access"],
          "enumDescriptions": [
            "Ask for a one-shot decision before every tool call.",
            "Run operations inside the workspace sandbox automatically and ask before an elevated retry.",
            "Disable tool approval and remove sandbox boundaries. Extremely dangerous; only use in a fully trusted workspace."
          ],
          "scope": "machine",
          "default": "manual",
          "description": "Tool approval mode: manual, workspace sandbox, or unrestricted full access."
        },
        "deepseekHarness.autoAllowTools": {
          "type": "array",
          "items": { "type": "string", "enum": ["read"] },
          "uniqueItems": true,
          "default": [],
          "scope": "machine",
          "description": "Low-risk tools that may bypass prompts in manual mode. Only workspace-scoped read is supported; secrets and protected paths remain blocked."
        },
        "deepseekHarness.disabledFeatureGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["skills", "subagents", "workflows", "todo", "compaction"]
          },
          "uniqueItems": true,
          "default": [],
          "scope": "machine",
          "description": "Optional Harness feature groups disabled from the settings and management panel. Core Cordis components cannot be disabled here; changes restart Harness."
        },
        "deepseekHarness.thoughtDisplay": {
          "type": "string",
          "enum": ["expanded", "collapsed", "hidden"],
          "enumDescriptions": [
            "Show thought content expanded.",
            "Show thought activity with details collapsed.",
            "Hide thought entries."
          ],
          "default": "collapsed",
          "description": "How model-provided ACP thought chunks are displayed."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check src/acpTransport.js && node --check src/security.js && node --check media/i18n.js && node --check media/main.js && node --check adapter/acp-bridge.mjs && node --check adapter/runtime-feature-filter.mjs",
    "smoke:acp": "node tests/smoke-acp.js",
    "smoke:approval": "node tests/smoke-approval-mode.mjs",
    "smoke:auto-approval": "node tests/smoke-auto-approval.mjs",
    "smoke:compact": "node tests/smoke-compact.js",
    "smoke:feature-groups": "node tests/smoke-feature-groups.mjs",
    "smoke:git": "node tests/smoke-git.mjs",
    "smoke:i18n": "node tests/smoke-i18n.mjs",
    "smoke:resume": "node tests/smoke-resume.js",
    "smoke:vision": "node tests/smoke-vision.mjs",
    "prepackage": "node scripts/prepare-package.js",
    "package": "npx --yes @vscode/vsce@latest package --out dist/deepseek-harness-vscode.vsix"
  }
}
